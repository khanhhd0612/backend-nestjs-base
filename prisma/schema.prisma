generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

model User {
    id              String    @id @default(auto()) @map("_id") @db.ObjectId
    email           String    @unique
    password        String
    fullName        String    @map("full_name")
    role            String    @default("user")
    isActive        Boolean   @default(true) @map("is_active")
    tokenValidAfter DateTime  @default(now()) @map("token_valid_after")
    createdAt       DateTime  @default(now()) @map("created_at")
    updatedAt       DateTime  @updatedAt @map("updated_at")
    deletedAt       DateTime? @map("deleted_at")

    @@map("users")
}

model BlacklistedToken {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    jti       String   @unique
    userId    String   @db.ObjectId
    expiresAt DateTime @map("expires_at") //thời điểm token gốc hết hạn

    @@map("blacklisted_tokens")
}

model UserSession {
    id         String    @id @default(auto()) @map("_id") @db.ObjectId
    userId     String    @db.ObjectId
    jti        String    @unique // jti của refresh token, dùng để link với blacklist khi revoke
    userAgent  String?   @map("user_agent")
    ip         String?
    deviceName String?   @map("device_name")
    createdAt  DateTime  @default(now()) @map("created_at")
    lastUsedAt DateTime  @default(now()) @map("last_used_at")
    expiresAt  DateTime  @map("expires_at")
    revokedAt  DateTime? @map("revoked_at")

    @@index([userId])
    @@map("user_sessions")
}

model PasswordResetToken {
    id        String    @id @default(auto()) @map("_id") @db.ObjectId
    email     String // lưu thô để rate-limit được kể cả khi email không tồn tại trong hệ thống
    userId    String?   @db.ObjectId // null nếu email không tồn tại (vẫn tạo record để rate-limit công bằng)
    tokenHash String    @unique
    expiresAt DateTime  @map("expires_at")
    usedAt    DateTime? @map("used_at")
    createdAt DateTime  @default(now()) @map("created_at")

    @@index([email, createdAt])
    @@map("password_reset_tokens")
}
